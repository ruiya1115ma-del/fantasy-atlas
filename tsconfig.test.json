{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "jsx": "react-jsx",
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": false,
    "incremental": false,
    "plugins": []
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["node_modules", "app", "components", ".next"]
}
